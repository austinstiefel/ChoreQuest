# Allow only inputs actually used by this Dockerfile. Recovery snapshots,
# tests, documentation and arbitrary local files never enter the build context.
**
!frontend/
!frontend/src/
!frontend/src/**
!frontend/public/
!frontend/public/**
!frontend/index.html
!frontend/package.json
!frontend/package-lock.json
!frontend/vite.config.js
!server/
!server/src/
!server/src/**
!server/prisma/
!server/prisma/schema.prisma
!server/prisma/migrations/
!server/prisma/migrations/**
!server/package.json
!server/pnpm-lock.yaml
!server/tsconfig.json
!server/scripts/
!server/scripts/initialize-sqlite.mjs
!server/scripts/staging-init.mjs
!server/Dockerfile.node
!server/Dockerfile.node.dockerignore
**/node_modules
**/dist
**/.env
**/.env.*
**/*.env
.git
.aws
.codex
.agents
.venv
data
backups
staging-private
**/*.backup
**/*.bak
static
**/*.db
**/*.db-*
**/*.sqlite
**/*.sqlite-*
**/*.sqlite3
**/*.sqlite3-*
**/__pycache__
**/*.diff
**/*.pem
**/*.key
**/*.p12
**/*.pfx
