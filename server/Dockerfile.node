# Separate opt-in image; the existing Python Dockerfile/service is unchanged.
# Build context: repository root. Provision/migrate a NEW/COPIED database
# explicitly with the existing deployment tools before starting this image.
FROM node:22-bookworm-slim AS frontend-build
WORKDIR /build/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

FROM node:22-bookworm-slim AS server-build
WORKDIR /build/server
RUN corepack enable && corepack prepare pnpm@10.34.6 --activate
COPY server/package.json server/pnpm-lock.yaml ./
COPY server/prisma/ ./prisma/
RUN pnpm install --frozen-lockfile && pnpm prisma:generate
COPY server/tsconfig.json ./
COPY server/src/ ./src/
RUN pnpm build && pnpm prune --prod

FROM node:22-bookworm-slim AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates openssl tzdata && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=server-build --chown=node:node /build/server/node_modules ./server/node_modules/
COPY --from=server-build --chown=node:node /build/server/dist ./server/dist/
COPY --from=server-build --chown=node:node /build/server/prisma ./server/prisma/
COPY --from=server-build --chown=node:node /build/server/package.json ./server/package.json
COPY --from=frontend-build --chown=node:node /build/frontend/dist ./static/
RUN mkdir -p /app/data/uploads && chown node:node /app/data /app/data/uploads
USER node
ENV NODE_ENV=production HOST=0.0.0.0 PORT=8122 STATIC_DIR=/app/static UPLOAD_DIR=/app/data/uploads
EXPOSE 8122
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s CMD node -e "fetch('http://127.0.0.1:8122/api/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
CMD ["node", "server/dist/server.js"]
